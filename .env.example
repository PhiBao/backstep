# Meta Model API key (get one at dev.meta.ai — $150 credits per hackathon participant)
MODEL_API_KEY=
# Optional overrides
META_BASE_URL=https://api.meta.ai/v1
PORT=8787
BACKSTEP_DATA_DIR=../data
# Frontend -> backend (Next.js rewrite target, used when NEXT_PUBLIC_BACKEND_URL is unset)
BACKSTEP_BACKEND=http://127.0.0.1:8787
# Browser -> backend direct base URL (bypasses the Next.js proxy for large uploads).
# Set this in web/.env.local for local dev; set it to the deployed API origin in production.
# NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8787
